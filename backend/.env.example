# Database Configuration
DATABASE_URL=

# JWT Authentication
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI/LLM Configuration
CHAT_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text

# Vector Database
CHROMA_DIRECTORY=chroma_db

# RAG Configuration
TOP_K=2

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Attachment Security
ATTACHMENT_STORAGE_PATH=./storage/attachments

# Email verification SMTP (leave SMTP_HOST empty for local development)
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true

# PQC identity keys
PQC_ENABLED=true
PQC_ALGORITHM=ML-KEM-768+ML-DSA-65
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PQC_MASTER_KEY=
PQC_SESSION_TTL_MINUTES=60
PQC_SESSION_RATE_LIMIT=30
